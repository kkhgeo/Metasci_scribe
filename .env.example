# Metasci Scribe: copy to .env and fill in the key you use.
#
# A .env file in a paper folder is honored for provider API keys ONLY.
# Endpoints (OPENAI_BASE_URL, ANTHROPIC_BASE_URL), proxies and every
# METASCI_SCRIBE_* setting are ignored there. Set those in your shell
# environment or with `metasci-scribe config set ...`.
#
# You do not need a key to use a ChatGPT plan: run /login in the app.

# platform.openai.com
OPENAI_API_KEY=
# console.anthropic.com
ANTHROPIC_API_KEY=
