{
    "dependencies": ["."],
    "graphs": {
        "metasci-scribe": "metasci_scribe.langgraph_dev.main_graph:scribe_agent",
        "writing-agent": "metasci_scribe.langgraph_dev.graphs:writing_agent",
        "data-analysis-agent": "metasci_scribe.langgraph_dev.graphs:data_analysis_agent",
        "scheduler": "metasci_scribe.langgraph_dev.graphs:scheduler",
        "expert-container-async": "metasci_scribe.langgraph_dev.graphs:expert_container_async",
        "evomemory-subagent-worker": "metasci_scribe.langgraph_dev.graphs:evomemory_subagent_worker",
        "evomemory-turn-worker": "metasci_scribe.langgraph_dev.graphs:evomemory_turn_worker",
        "evomemory-observation-linker": "metasci_scribe.langgraph_dev.graphs:evomemory_observation_linker",
        "evomemory-autoskills": "metasci_scribe.langgraph_dev.graphs:evomemory_autoskills",
        "proactive": "metasci_scribe.langgraph_dev.graphs:proactive"
    },
    "checkpointer": {
        "backend": "custom",
        "path": "metasci_scribe.sessions.create_checkpointer_for_langgraph_api"
    },
    "config": {
        "recursion_limit": 1000000
    },
    "http": {
        "app": "metasci_scribe.langgraph_dev.http:app",
        "cors": {
            "allow_origins": [],
            "allow_origin_regex": "https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:\\d+)?",
            "allow_methods": ["*"],
            "allow_headers": ["*"],
            "expose_headers": ["x-pagination-total", "x-pagination-next", "content-location"]
        }
    }
}
